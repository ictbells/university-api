APP_NAME="Bells University of Technology"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://bells-api.example.com
FRONTEND_URL=https://staff.example.com
STUDENT_URL=https://student.example.com

# Comma-separated extra CORS origins (www alternates are added automatically from FRONTEND_URL / STUDENT_URL).
CORS_ALLOWED_ORIGINS=https://staff.example.com,https://www.staff.example.com,https://student.example.com,https://www.student.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=bells_sis
DB_USERNAME=
DB_PASSWORD=

# Required in production (DatabaseSeeder and php artisan production:check).
# Never use Password1!.
SUPER_ADMIN_EMAIL=superadmin@bellsuniversity.edu.ng
SUPER_ADMIN_PASSWORD=

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.example.com
SESSION_COOKIE=bells_sis_session
SESSION_SECURE_COOKIE=true
# Staff SPA uses cookie/CSRF (stateful). Student SPA uses Bearer tokens — do NOT list student hosts here.
SANCTUM_STATEFUL_DOMAINS=staff.example.com,www.staff.example.com,bells-api.example.com

# Admissions VPS (8 GB / 120 GB SSD): prefer redis. Requires redis-server + php8.4-redis.
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
FILESYSTEM_DISK=s3

MAIL_MAILER=ses
MAIL_FROM_ADDRESS="noreply@bellsuniversity.edu.ng"
MAIL_FROM_NAME="Bells University of Technology"

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_ALLOW_DEMO_FULFILL=false
WEMA_ALATPAY_PUBLIC_KEY=
WEMA_ALATPAY_SECRET_KEY=
WEMA_ALATPAY_BUSINESS_ID=
WEMA_ALATPAY_WEBHOOK_SECRET=
WEMA_ALATPAY_BASE_URL=https://apibox.alatpay.ng
PREMBLY_API_KEY=
PREMBLY_APP_ID=
PREMBLY_BASE_URL=https://api.prembly.com
PREMBLY_ALLOW_DEMO=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

LOAD_ENV_FROM_S3=false
ENV_S3_BUCKET=
ENV_S3_KEY=

# Last issued matric. Next auto-generated number is this serial + 1 for the same year.
# Example: MATRIC_LAST=2026/000150  →  next is 2026/000151
MATRIC_LAST=
MATRIC_YEAR=
