#!/bin/bash
# Tiny launcher under the 16 KiB EC2 user-data limit. Full bootstrap lives in S3.
set -euxo pipefail
exec > >(tee -a /var/log/bells-sis-bootstrap-launcher.log) 2>&1

REGION="${region}"
DEST=/var/lib/cloud/bells-sis-user-data.sh
S3_URI="s3://${bootstrap_s3_bucket}/${bootstrap_s3_key}"
BOOTSTRAP_MD5="${bootstrap_script_md5}"

echo "bells-sis launcher start $(date -u +%Y-%m-%dT%H:%M:%SZ) md5=$BOOTSTRAP_MD5"

# Ubuntu 24.04 Noble has no apt awscli package — install AWS CLI v2 if missing.
if ! command -v aws >/dev/null 2>&1; then
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -y
  apt-get install -y curl unzip ca-certificates
  tmpdir="$(mktemp -d)"
  arch="$(uname -m)"
  curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-$${arch}.zip" -o "$tmpdir/awscliv2.zip"
  unzip -q "$tmpdir/awscliv2.zip" -d "$tmpdir"
  "$tmpdir/aws/install" --update
  rm -rf "$tmpdir"
fi

for i in $(seq 1 90); do
  if aws sts get-caller-identity --region "$REGION" >/dev/null 2>&1; then
    break
  fi
  sleep 2
done
aws sts get-caller-identity --region "$REGION" >/dev/null

mkdir -p /var/lib/cloud
aws s3 cp "$S3_URI" "$DEST" --region "$REGION"
chmod 0700 "$DEST"
echo "bells-sis launcher exec $DEST"
exec /bin/bash "$DEST"
