APP_NAME="Bells University of Technology"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# Public student SPA URL used in emails and payment callbacks. Must be absolute (http/https).
# Vite: http://localhost:5174/student
# Apache under htdocs/office: http://localhost/office/student
STUDENT_URL=http://localhost:5174/student

# Comma-separated extra CORS origins (www alternates, etc.). FRONTEND_URL and STUDENT_URL are always included.
# Production example:
# CORS_ALLOWED_ORIGINS=https://staff.cycbankease.com,https://www.staff.cycbankease.com,https://student.cycbankease.com,https://www.student.cycbankease.com
CORS_ALLOWED_ORIGINS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bells
DB_USERNAME=root
DB_PASSWORD=

# Production on cycbankease.com (shared apex with BankEase): use a distinct cookie name.
# SESSION_DOMAIN=.cycbankease.com
# SESSION_COOKIE=bells_sis_session
# SESSION_SECURE_COOKIE=true
# XSRF cookie is Bells-XSRF-TOKEN (not XSRF-TOKEN) so BankEase cannot overwrite it.
# APP_URL=https://bells-api.cycbankease.com
# FRONTEND_URL=https://staff.cycbankease.com
# STUDENT_URL=https://student.cycbankease.com
# Staff SPA uses cookie/CSRF (stateful). Student SPA uses Bearer tokens — do NOT list student hosts here.
# SANCTUM_STATEFUL_DOMAINS=staff.cycbankease.com,www.staff.cycbankease.com,bells-api.cycbankease.com
# Use a new MySQL schema on prod-bankease (e.g. bells_sis) — never the bankease database.

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_COOKIE=
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173,localhost:8000

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
# Set FILESYSTEM_DISK=s3 and fill AWS_* below to store uploads (docs, photos,
# transcript PDFs, import spreadsheets) on S3 instead of local disk.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@bellsuniversity.edu.ng"
MAIL_FROM_NAME="Bells University of Technology"

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_ALLOW_DEMO_FULFILL=false
PREMBLY_API_KEY=
PREMBLY_APP_ID=
PREMBLY_BASE_URL=https://api.prembly.com
# Production must set API key + app id. Empty keys otherwise return demo biodata
# when APP_ENV is not production. Set false to always require live Prembly.
PREMBLY_ALLOW_DEMO=

# Super Admin (DatabaseSeeder). Optional locally (defaults to superadmin@bellsuniversity.edu.ng / Password1!).
# Production requires both; refuses Password1!.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# nginx / Apache on the same host. Do not set * on a public PHP listener.
# TRUSTED_PROXIES=127.0.0.1,::1

# Production overlay template: copy api/.env.production.example → server .env
# LOG_CHANNEL=stack
# LOG_STACK=daily
# LOG_LEVEL=info
# SESSION_ENCRYPT=true
# SESSION_SECURE_COOKIE=true
# FILESYSTEM_DISK=s3
# PAYSTACK_ALLOW_DEMO_FULFILL=false
# PREMBLY_ALLOW_DEMO=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# GitHub secrets ENV_S3_BUCKET + ENV_S3_KEY. Object is s3://$ENV_S3_BUCKET/$ENV_S3_KEY/.env
# (if ENV_S3_KEY already ends with .env, that key is used as-is).
LOAD_ENV_FROM_S3=false
ENV_S3_BUCKET=
ENV_S3_KEY=
