APP_NAME="Bells University of Technology"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
STUDENT_URL=http://localhost:5174/student

# Comma-separated extra CORS origins (www alternates, etc.). FRONTEND_URL and STUDENT_URL are always included.
# Production example:
# CORS_ALLOWED_ORIGINS=https://staff.cycbankease.com,https://www.staff.cycbankease.com,https://student.cycbankease.com,https://www.student.cycbankease.com
CORS_ALLOWED_ORIGINS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bells
DB_USERNAME=root
DB_PASSWORD=

# Production on cycbankease.com (shared apex with BankEase): use a distinct cookie name.
# SESSION_DOMAIN=.cycbankease.com
# SESSION_COOKIE=bells_sis_session
# SESSION_SECURE_COOKIE=true
# XSRF cookie is Bells-XSRF-TOKEN (not XSRF-TOKEN) so BankEase cannot overwrite it.
# APP_URL=https://bells-api.cycbankease.com
# FRONTEND_URL=https://staff.cycbankease.com
# STUDENT_URL=https://student.cycbankease.com
# SANCTUM_STATEFUL_DOMAINS=staff.cycbankease.com,www.staff.cycbankease.com,student.cycbankease.com,www.student.cycbankease.com,bells-api.cycbankease.com
# Use a new MySQL schema on prod-bankease (e.g. bells_sis) — never the bankease database.

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_COOKIE=
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:5174,127.0.0.1,127.0.0.1:5173,127.0.0.1:5174,localhost:8000

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@bellsuniversity.edu.ng"
MAIL_FROM_NAME="${APP_NAME}"

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_ALLOW_DEMO_FULFILL=false
PREMBLY_API_KEY=
PREMBLY_APP_ID=
PREMBLY_BASE_URL=https://api.prembly.com
# Production must set API key + app id. Empty keys otherwise return demo biodata
# when APP_ENV is not production. Set false to always require live Prembly.
PREMBLY_ALLOW_DEMO=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# When true, deploy (and `php artisan env:pull-s3`) downloads .env from S3.
LOAD_ENV_FROM_S3=false
ENV_S3_BUCKET=
ENV_S3_KEY=api/.env
